#include <windows.h>
101 ICON "GlowTray.ico"
1 RT_MANIFEST "app.manifest"

102 DIALOGEX 0, 0, 240, 98
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Add a light"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Light's IP address or hostname (optional :port):", -1, 12, 12, 215, 12
    EDITTEXT 3001, 12, 30, 215, 16, ES_AUTOHSCROLL
    DEFPUSHBUTTON "Connect", IDOK, 119, 65, 52, 18
    PUSHBUTTON "Cancel", IDCANCEL, 177, 65, 50, 18
END

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "GlowTray - local light controller"
            VALUE "FileVersion", "1.0.0"
            VALUE "ProductName", "GlowTray"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
